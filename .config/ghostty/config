# Use prerelease build where macos tabs are fixed on Golden Gate
auto-update-channel = tip

theme = iTerm2 Pastel Dark Background
background-opacity = 0.85
background-blur = macos-glass-regular
background-blur-radius = 18

# Testing new font
font-family = Ioskeley Mono Term
font-size = 14

# Thicker font on macOS (better for non-Retina displays)
font-thicken = true

# no native titlebar and window decorations on macOS
# macos-titlebar-style values: hidden, transparent, native, tabs
# TODO: temporary workaround for https://github.com/ghostty-org/ghostty/discussions/14244
macos-titlebar-style = tabs
window-padding-x = 8
window-padding-y = 8

mouse-scroll-multiplier = 3

window-save-state = never
window-width = 118
window-height = 45

# Fix terminfo issues in ssh sessions
shell-integration-features = ssh-env,ssh-terminfo

